# Runtime state and output — machine-specific, never shared.
logs/*
!logs/.gitkeep
state/*
!state/.gitkeep
workspace/*
!workspace/.gitkeep
output/

# Secrets live in ~/.config/quarterdeck/env, never here. Belt and braces:
*.env.local
.env

# Python bytecode from bin/dashboard.py and bin/selftest.py
__pycache__/
*.pyc

# Machine and employer specific: which local agent folders Quarterdeck may show and start (see bin/fleetview.py)
config/fleet.local.json

# machine-local, never committed
guard-denylist.txt

# your own speech hints (words your recogniser should expect, mishearings to fix)
config/speech.json
.claude/worktrees/
.playwright-mcp/
.t
.DS_Store

# release files made by bin/release.py
dist/release/
