# Quarterdeck tunables. Shared, committed, non-secret.
# Per-machine overrides and anything sensitive go in ~/.config/quarterdeck/env,
# which lib.sh sources afterwards so it always wins.

# ---- models: matched to the job, per the fleet owner's standing policy ------
#   mechanical or repetitive (filing, board notes, test generation)  -> Haiku
#   routine implementation and review                                -> Sonnet
#   intricate or cross-cutting                                        -> Opus
#   hard to reverse (schema, auth, money, security)                   -> Opus, xhigh
# Measured floor cost of one call before it does anything: Opus $0.25,
# Sonnet $0.13, Haiku $0.05 — and every tool step re-reads the whole context,
# so the gap widens with every turn. Empty means the account's default model,
# which is how Opus is selected. Most specific wins: a crew persona's own
# `model:` (panel seats), then QUARTERDECK_MODEL_<DUTY>, then QUARTERDECK_MODEL.
QUARTERDECK_MODEL="${QUARTERDECK_MODEL:-}"
QUARTERDECK_MODEL_FOREMAN="${QUARTERDECK_MODEL_FOREMAN:-claude-haiku-4-5}"
QUARTERDECK_MODEL_TRIALS="${QUARTERDECK_MODEL_TRIALS:-claude-haiku-4-5}"
QUARTERDECK_MODEL_HARBOURMASTER="${QUARTERDECK_MODEL_HARBOURMASTER:-claude-sonnet-5}"
QUARTERDECK_MODEL_PURSER="${QUARTERDECK_MODEL_PURSER:-claude-sonnet-5}"
QUARTERDECK_MODEL_PLANNER="${QUARTERDECK_MODEL_PLANNER:-claude-sonnet-5}"
QUARTERDECK_MODEL_SURVEYOR="${QUARTERDECK_MODEL_SURVEYOR:-claude-sonnet-5}"
QUARTERDECK_MODEL_INSPECTOR="${QUARTERDECK_MODEL_INSPECTOR:-claude-sonnet-5}"
QUARTERDECK_MODEL_JOINER="${QUARTERDECK_MODEL_JOINER:-claude-sonnet-5}"
QUARTERDECK_MODEL_SHIPWRIGHT="${QUARTERDECK_MODEL_SHIPWRIGHT:-claude-sonnet-5}"
QUARTERDECK_MODEL_INFRA="${QUARTERDECK_MODEL_INFRA:-claude-sonnet-5}"
QUARTERDECK_MODEL_BRIEF="${QUARTERDECK_MODEL_BRIEF:-claude-sonnet-5}"
QUARTERDECK_MODEL_MOCKUP="${QUARTERDECK_MODEL_MOCKUP:-claude-sonnet-5}"
# Effort trades thoroughness for fewer, more consolidated tool steps. Empty
# leaves each model at its own default. Never sent to Haiku.
QUARTERDECK_EFFORT="${QUARTERDECK_EFFORT:-}"

# ---- a fix is routed by how hard the item is ---------------------------------
# The chair labels every ruling item with a tier; the fix pipeline plans and
# builds to match. mechanical: no developer panel — the panel that raised it
# already decided what to do — and a Haiku build. routine: a light panel, one
# round, on Sonnet. intricate: the full panel. hard: the full panel on Opus at
# xhigh. Set QUARTERDECK_FIX_PLANNING=full to put every item through the full panel.
QUARTERDECK_FIX_PLANNING="${QUARTERDECK_FIX_PLANNING:-tiered}"
QUARTERDECK_TIER_MECHANICAL="${QUARTERDECK_TIER_MECHANICAL:-claude-haiku-4-5}"
QUARTERDECK_TIER_ROUTINE="${QUARTERDECK_TIER_ROUTINE:-claude-sonnet-5}"
QUARTERDECK_TIER_INTRICATE="${QUARTERDECK_TIER_INTRICATE:-}"
QUARTERDECK_TIER_HARD="${QUARTERDECK_TIER_HARD:-}"

# ---- spend limits -------------------------------------------------------------
# Per model call: a runaway guard, checked between tool steps, so a call can
# overshoot by one step. Measured calls so far have averaged $0.47-$3.66; a
# call past this has gone wrong. Empty disables it.
QUARTERDECK_CALL_BUDGET="${QUARTERDECK_CALL_BUDGET:-6}"
# Per day, for work nobody pressed a button for: the fix queue and schedules
# start nothing new once today's recorded spend reaches this. A run you start by
# hand is never stopped by it. Empty means no daily limit. Figures are the CLI's
# API-equivalent cost; on a subscription they measure usage-limit consumption.
#
# 120 from the four days on record in state/spend.jsonl, not from taste:
#   2026-09-20  $44.35 over 27 calls
#   2026-09-21  $37.65 over 29 calls
#   2026-09-22  $92.61 over 68 calls
#   2026-09-23  $78.08 over 79 calls
# The worst real day was $93, so this clears it by about a third. Low enough to
# stop a runaway inside one day, high enough that an ordinary busy day never
# hits it — a cap that fires on normal work would just get raised until it
# meant nothing. Revisit when a week of batched runs has been recorded: fewer,
# larger fixes should move the shape of this.
QUARTERDECK_DAILY_BUDGET="${QUARTERDECK_DAILY_BUDGET:-120}"
# Per `quarterdeck cycle`: the most one cycle may spend (API-equivalent dollars). A stage that would cross it is not started; the record says
# "stopped at the cycle ceiling" and `quarterdeck cycle --resume <id>` goes on once it is raised. A cycle also honours QUARTERDECK_DAILY_BUDGET.
QUARTERDECK_CYCLE_BUDGET="${QUARTERDECK_CYCLE_BUDGET:-15}"

# Review depth passed through to /code-review. low|medium|high|max
QUARTERDECK_REVIEW_EFFORT="${QUARTERDECK_REVIEW_EFFORT:-medium}"

# Wall-clock ceiling for a single model call, in seconds. A wedged run holds a
# lock, so this is the thing that stops one bad job from pausing a duty forever.
QUARTERDECK_RUN_TIMEOUT="${QUARTERDECK_RUN_TIMEOUT:-900}"

# Most work a single run may do, so a misfire is bounded. A duty that wants to
# process more than this must be run again rather than given a bigger budget.
QUARTERDECK_MAX_ITEMS="${QUARTERDECK_MAX_ITEMS:-5}"

# Writes are opt-in: `quarterdeck run` reports and changes nothing unless --apply is
# passed. This is a DEFAULT, not a lock — --apply still writes while it is 1.
# Setting it to 0 makes every run write without being asked, which is a thing to
# do per machine in ~/.config/quarterdeck/env once a duty has earned that trust, not
# here.
QUARTERDECK_DRY_RUN="${QUARTERDECK_DRY_RUN:-1}"

# The real enforcement boundary for a model run (an allowlist alone does not
# restrict anything under non-interactive permission modes). Everything that
# could write, publish, spend, or leave the machine belongs here.
QUARTERDECK_DENY_TOOLS="${QUARTERDECK_DENY_TOOLS:-Write,Edit,NotebookEdit,WebFetch,WebSearch,Bash(git push*),Bash(git commit*),Bash(gh pr create*),Bash(gh pr merge*),Bash(gh pr review*),Bash(gh pr comment*),Bash(gh issue create*),Bash(gh issue comment*),Bash(gh release*),Bash(gh api*),Bash(npm publish*),Bash(rm*),Bash(curl*),Bash(ssh*)}"
# Files no agent may read, whatever tool list a duty passes. bin/lib.sh builds the list itself (private_paths: the calendar and reminders
# snapshots, brain-dump notes and agenda status in state/connectors/**, state/capture.jsonl, state/agenda-status.json, state/attention.json*,
# state/intent.jsonl*, state/hand-runs.jsonl*, state/rhythm-tasks.json* and state/project-status.json*, under BOTH the data folder and the
# program folder; plus ~/.config/quarterdeck, ~/.config/gh, ~/.ssh, ~/.aws, ~/.gnupg, ~/.npmrc, ~/.netrc, ~/.docker/config.json, Library/Keychains,
# and any .env*, *.pem, *.key, *.p12 anywhere) and renders it twice: as Read deny rules and as the OS sandbox's denyRead. This setting can only
# ADD rules (comma separated Read(...) rules) to that floor; it cannot remove any.
QUARTERDECK_PRIVATE_DENY="${QUARTERDECK_PRIVATE_DENY:-}"

# Helm, the voice assistant. The voice is any Kokoro voice (am_liam, am_puck, am_eric,
# bf_emma, af_heart ...); speed is 0.7 to 1.4.
QUARTERDECK_HELM_VOICE="${QUARTERDECK_HELM_VOICE:-am_liam}"
QUARTERDECK_HELM_SPEED="${QUARTERDECK_HELM_SPEED:-1.05}"

# An operating-system sandbox for every model call that has a shell (builders: shipwright, caulker, assayer, trials): it hides the private
# files from every shell command they run, lets them write only inside their working folder, blocks the network, and has no
# unsandboxed escape. On. Models no longer run gh (the harness fetches and posts), so there is no exception. Set it to off here only if a
# build fails with a "restricted by sandbox access controls" message, and know that this removes the shell confinement.
QUARTERDECK_SANDBOX="${QUARTERDECK_SANDBOX:-on}"

# Helm's deep brain: talk with Claude instead of the local model. OFF by default. When "on", a "Think with Claude" switch
# appears in Helm's chat and saying "think with me" uses it. It can only talk (every tool is switched off), each turn is
# capped, and the day is capped from the spend ledger (duty helm-chat). Your agenda and notes are never sent unless you say
# "include my agenda" or "include my notes" in that conversation. It is always off in Demo mode.
QUARTERDECK_HELM_CLAUDE="${QUARTERDECK_HELM_CLAUDE:-on}"
QUARTERDECK_HELM_CLAUDE_MODEL="${QUARTERDECK_HELM_CLAUDE_MODEL:-claude-haiku-4-5}"
QUARTERDECK_HELM_CLAUDE_TURN_BUDGET="${QUARTERDECK_HELM_CLAUDE_TURN_BUDGET:-0.05}"
QUARTERDECK_HELM_CLAUDE_DAILY="${QUARTERDECK_HELM_CLAUDE_DAILY:-1.00}"

# Where the owner's attention goes (the Brain's Attention panel). The collector reads, on this Mac, only the timestamps of
# your Claude Code turns, your own git commits, and the dates of pull requests, notes and meetings, never what was said or
# written, and keeps counts in state/attention.json, which no agent can read. "off" stops the collector and deletes nothing.
QUARTERDECK_ATTENTION="${QUARTERDECK_ATTENTION:-on}"
# My rhythm's task timeline ("what was I working on, and when") keeps the owner's own words, so it is stored apart from the counts: commit subject
# lines, branch names, pull request titles, note text, run objectives and calendar titles, in state/rhythm-tasks.json (owner only, no agent can read it,
# never sent to any model or off this Mac, 400 days). "off" stops collecting them. Delete what is stored with: rm -f state/rhythm-tasks.json
QUARTERDECK_RHYTHM_TASKS="${QUARTERDECK_RHYTHM_TASKS:-on}"
